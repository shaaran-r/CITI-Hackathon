{
  "expo": {
    "name": "KaushalSetu",
    "slug": "kaushalsetu",
    "scheme": "kaushalsetu",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow KaushalSetu to use your microphone for voice discovery.",
          "speechRecognitionPermission": "Allow KaushalSetu to transcribe your voice for voice discovery."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "org.kaushalsetu.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "owner": "sharan_00123",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a3ebe37-a51e-4156-8b3b-4dc50731fd2c"
      }
    }
  }
}

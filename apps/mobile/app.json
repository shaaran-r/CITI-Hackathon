{
  "expo": {
    "name": "KaushalSetu",
    "slug": "kaushalsetu",
    "scheme": "kaushalsetu",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow KaushalSetu to use your microphone for voice discovery.",
          "speechRecognitionPermission": "Allow KaushalSetu to transcribe your voice for voice discovery."
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "android": { "package": "org.kaushalsetu.mobile" },
    "owner": "sharan-1447",
    "extra": {
      "eas": {
        "projectId": "4a7de188-b306-4caf-aa4f-65faa3e0c1a6"
      }
    }
  }
}

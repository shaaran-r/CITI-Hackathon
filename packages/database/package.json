{
  "name": "@kaushalsetu/database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "db:generate:deploy": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:deploy:runtime": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.1",
    "tsx": "^4.20.6"
  }
}
